rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;

      match /favorites/{itemId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /items/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'available';
      // Владелец редактирует своё объявление; другой пользователь может только «забрать» доступную вещь.
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
        || (resource.data.ownerId != request.auth.uid
          && resource.data.status == 'available'
          && request.resource.data.status == 'claimed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /deals/{dealId} {
      allow read: if signedIn()
        && (resource.data.giverId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.receiverId == request.auth.uid;
    }
  }
}
